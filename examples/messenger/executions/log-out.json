{
  "name": "Log out",
  "description": "Ada signs out: her session is removed and the page goes back to signing in.",
  "trigger": {
    "at": "app/client.logOut",
    "kind": "action",
    "description": "Ada presses sign out.",
    "code": "src/client/state.ts#dispatch"
  },
  "trace": [
    {
      "from": "app/client.logOut",
      "to": "app/client/state",
      "kind": "call",
      "description": "Pressing sign out tells the page's state to end the session.",
      "code": "src/client/state.ts#dispatch",
      "payload": {
        "type": "logOut"
      }
    },
    {
      "from": "app/client/state",
      "to": "app/api.logOut",
      "kind": "call",
      "description": "The page asks the API to end the session it is signed in with.",
      "code": "src/client/state.ts#dispatch",
      "payload": {
        "sessionId": "s-1"
      },
      "response": {
        "redirect": "/login"
      }
    },
    {
      "from": "app/api.logOut",
      "to": "app/api/router",
      "kind": "call",
      "description": "The HTTP server turns the request into a call to the router.",
      "code": "src/server.ts#handle",
      "payload": {
        "path": "/logout"
      }
    },
    {
      "from": "app/api/router",
      "to": "app/api/auth/log-out",
      "kind": "call",
      "description": "The router hands signing out to the part of the API that does it.",
      "code": "src/api/router.ts#route",
      "payload": {
        "sessionId": "s-1"
      },
      "response": {
        "redirect": "/login"
      }
    },
    {
      "from": "app/api/auth/log-out",
      "to": "app/infrastructure/database.sessions",
      "kind": "remove",
      "description": "The session is taken out, so nothing can be done with it again.",
      "code": "src/api/auth.ts#logOut",
      "payload": {
        "id": "s-1"
      }
    },
    {
      "effect": "row-removed",
      "description": "The session is gone from the database.",
      "code": "src/infrastructure/db.ts#db",
      "at": "app/infrastructure/database.sessions",
      "detail": {
        "id": "s-1"
      }
    },
    {
      "effect": "response",
      "description": "The API answers with where the page should go next.",
      "code": "src/api/router.ts#route",
      "at": "app/api.logOut",
      "detail": {
        "status": 200,
        "redirect": "/login"
      }
    },
    {
      "from": "app/client/state",
      "to": "app/client/ui/login-form",
      "kind": "call",
      "description": "The page forgets the session and goes back to the sign-in form.",
      "code": "src/client/state.ts#dispatch"
    },
    {
      "effect": "ui-changed",
      "description": "The sign-in form is what the person sees again.",
      "code": "src/client/ui/loginForm.ts#onLogInSubmitted",
      "at": "app/client/ui/login-form",
      "detail": {
        "screen": "login"
      }
    }
  ],
  "expect": {
    "interactions": [
      {
        "to": "app/api/auth/log-out"
      },
      {
        "to": "app/infrastructure/database.sessions",
        "kind": "remove"
      }
    ],
    "effects": [
      {
        "kind": "row-removed"
      },
      {
        "kind": "response",
        "detail": {
          "redirect": "/login"
        }
      }
    ],
    "never": [
      "app/api/messaging"
    ]
  }
}
