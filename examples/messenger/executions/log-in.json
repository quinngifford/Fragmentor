{
  "name": "Log in",
  "description": "Ada signs in with her email and password.",
  "trigger": {
    "at": "app/client/ui/login-form",
    "kind": "action",
    "description": "Ada fills in the sign-in form and submits it.",
    "code": "src/client/ui/loginForm.ts#onLogInSubmitted",
    "payload": {
      "email": "ada@example.com"
    }
  },
  "trace": [
    {
      "from": "app/client/ui/login-form",
      "to": "app/client/state",
      "kind": "call",
      "description": "Submitting the form hands the email and password to the page's state.",
      "code": "src/client/ui/loginForm.ts#onLogInSubmitted",
      "payload": {
        "type": "logIn",
        "email": "ada@example.com"
      }
    },
    {
      "from": "app/client/state",
      "to": "app/api.logIn",
      "kind": "call",
      "description": "The page asks the API to sign this person in.",
      "code": "src/client/state.ts#dispatch",
      "payload": {
        "email": "ada@example.com"
      },
      "response": {
        "sessionId": "s-1"
      }
    },
    {
      "from": "app/api.logIn",
      "to": "app/api/router",
      "kind": "call",
      "description": "The HTTP server turns the request into a call to the router.",
      "code": "src/server.ts#handle",
      "payload": {
        "path": "/login"
      }
    },
    {
      "from": "app/api/router",
      "to": "app/api/auth/log-in",
      "kind": "call",
      "description": "The router hands signing in to the part of the API that does it.",
      "code": "src/api/router.ts#route",
      "payload": {
        "email": "ada@example.com"
      },
      "response": {
        "sessionId": "s-1"
      }
    },
    {
      "from": "app/api/auth/log-in",
      "to": "app/infrastructure/database.users",
      "kind": "read",
      "description": "The person is looked up by the email they typed.",
      "code": "src/api/auth.ts#logIn",
      "payload": {
        "email": "ada@example.com"
      },
      "response": {
        "id": "ada"
      }
    },
    {
      "from": "app/api/auth/log-in",
      "to": "app/infrastructure/database.sessions",
      "kind": "write",
      "description": "A session is written down, so later requests can say who they are.",
      "code": "src/api/auth.ts#logIn",
      "payload": {
        "id": "s-1",
        "userId": "ada"
      }
    },
    {
      "effect": "row-changed",
      "description": "The session is now in the database, and will last until it runs out.",
      "code": "src/infrastructure/db.ts#db",
      "at": "app/infrastructure/database.sessions",
      "detail": {
        "id": "s-1"
      }
    },
    {
      "effect": "response",
      "description": "The API answers with the session the page is to use from now on.",
      "code": "src/api/router.ts#route",
      "at": "app/api.logIn",
      "detail": {
        "status": 200,
        "sessionId": "s-1"
      }
    },
    {
      "effect": "ui-changed",
      "description": "The page keeps the session and shows the conversation instead of the form.",
      "code": "src/client/state.ts#dispatch",
      "at": "app/client/state",
      "detail": {
        "screen": "chat"
      }
    }
  ],
  "expect": {
    "entered": [
      "app/api/auth"
    ],
    "effects": [
      {
        "at": "app/infrastructure/database.sessions",
        "kind": "row-changed"
      }
    ],
    "never": [
      "app/api/messaging",
      "app/infrastructure/queue"
    ]
  }
}
