{
  "responsibility": "Decide whether one member may take one book away, record it, and say what happened.",
  "inputs": {
    "memberId": { "type": "string", "description": "The number on the member's card." },
    "isbn": { "type": "string", "description": "The barcode on the book." }
  },
  "outputs": {
    "receipt": "{ title: string; dueInDays: number; message: string }"
  },
  "capabilities": {
    "books": { "capability": "Store", "description": "The catalogue, by ISBN." },
    "members": { "capability": "Store", "description": "The membership, by card number." },
    "notices": { "capability": "Queue", "description": "Where the member's copy of the receipt goes." }
  },
  "access": [
    "books reads catalogue.books",
    "books writes catalogue.books",
    "members reads catalogue.members",
    "notices writes notices.issued"
  ],
  "children": ["find-book", "check-member", "decide-loan", "issue-loan", "write-receipt"],
  "wires": [
    "input.isbn -> find-book.isbn",
    "input.memberId -> check-member.memberId",
    "find-book.book -> decide-loan.book",
    "check-member.member -> decide-loan.member",
    "find-book.book -> issue-loan.book",
    "check-member.member -> issue-loan.member",
    "decide-loan.allowed -> issue-loan.allowed",
    "decide-loan.dueInDays -> issue-loan.dueInDays",
    "find-book.book -> write-receipt.book",
    "decide-loan.allowed -> write-receipt.allowed",
    "decide-loan.reason -> write-receipt.reason",
    "decide-loan.dueInDays -> write-receipt.dueInDays",
    "issue-loan.copiesLeft -> write-receipt.copiesLeft",
    "write-receipt.receipt -> output.receipt"
  ]
}
