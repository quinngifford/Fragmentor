{
  "id": "score-posting",
  "name": "Score Posting",
  "responsibility": "Score a single posting against the profile keywords and explain the score.",
  "kind": "composite",
  "inputs": {
    "posting": {
      "type": "{ title: string; company: string; description: string }"
    },
    "keywords": {
      "type": "string[]"
    }
  },
  "outputs": {
    "score": {
      "type": "number"
    },
    "reasons": {
      "type": "string[]"
    }
  },
  "capabilities": {},
  "children": [
    {
      "block": "normalize-text",
      "mode": "once"
    },
    {
      "block": "match-keywords",
      "mode": "once"
    },
    {
      "block": "compute-relevance",
      "mode": "once"
    }
  ],
  "wires": [
    "input.posting -> normalize-text.posting",
    "normalize-text.tokens -> match-keywords.tokens",
    "input.keywords -> match-keywords.keywords",
    "match-keywords.matches -> compute-relevance.matches",
    "compute-relevance.score -> output.score",
    "compute-relevance.reasons -> output.reasons"
  ],
  "pinnedAsLeaf": false
}
