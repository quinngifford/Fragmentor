{
  "responsibility": "Produce the TypeScript contract source for one block from its ports, so the contract can never disagree with the diagram.",
  "inputs": {
    "blockId": {
      "type": "string",
      "description": "Kebab-case id, e.g. score-posting."
    },
    "blockName": "string",
    "responsibility": "string",
    "blockPath": {
      "type": "string",
      "description": "Path from the blocks root, used to locate shared modules."
    },
    "inputs": {
      "type": "{ name: string; type: string; description?: string }[]",
      "description": "Each type is an expression such as `string[]`."
    },
    "outputs": "{ name: string; type: string; description?: string }[]",
    "capabilities": "{ name: string; capability: string; description?: string }[]"
  },
  "outputs": {
    "source": {
      "type": "string",
      "description": "Contents of the block's contract.ts."
    }
  },
  "children": [
    "derive-names",
    "render-schemas",
    "render-capabilities",
    "assemble-source"
  ],
  "wires": [
    "input.blockId -> derive-names.blockId",
    "input.inputs -> render-schemas.inputs",
    "input.outputs -> render-schemas.outputs",
    "input.blockName -> render-capabilities.blockName",
    "input.blockPath -> render-capabilities.blockPath",
    "input.capabilities -> render-capabilities.capabilities",
    "derive-names.typeStem -> render-capabilities.typeStem",
    "input.blockName -> assemble-source.blockName",
    "input.responsibility -> assemble-source.responsibility",
    "derive-names.functionName -> assemble-source.functionName",
    "derive-names.typeStem -> assemble-source.typeStem",
    "render-schemas.inputSchema -> assemble-source.inputSchema",
    "render-schemas.outputSchema -> assemble-source.outputSchema",
    "render-capabilities.importLine -> assemble-source.importLine",
    "render-capabilities.capsDeclaration -> assemble-source.capsDeclaration",
    "assemble-source.source -> output.source"
  ]
}
