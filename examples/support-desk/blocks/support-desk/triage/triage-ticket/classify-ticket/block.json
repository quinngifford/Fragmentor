{
  "responsibility": "Read what the agent typed and say what kind of ticket it is, and whether it sounds urgent.",
  "inputs": {
    "ticket": "{ subject: string; body: string }"
  },
  "outputs": {
    "category": {
      "type": "\"billing\" | \"outage\" | \"bug\" | \"howto\"",
      "description": "What the ticket is about."
    },
    "urgent": "boolean"
  }
}
